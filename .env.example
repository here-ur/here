# 복사해서 .env.local로 쓰세요. .env.local은 커밋하지 않아요.
# 아래 환경변수는 서버(API 라우트)에서만 읽어요. NEXT_PUBLIC_ 붙이지 마세요.

# 글 대화 전용: Runyour AI 키. 음성용 OpenAI 키로 대체하지 않아요.
RUNYOUR_API_KEY=

# (선택) 글 대화 API 주소와 모델. 아래 값이 코드의 기본값이에요.
RUNYOUR_BASE_URL=https://api.runyour.ai/v1
CHAT_MODEL=openai/gpt-5.6-sol

# 음성 대화 전용 OpenAI 키: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (선택) 음성 realtime 모델. 비우면 gpt-realtime-2.1-mini.
REALTIME_MODEL=
