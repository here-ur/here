# 복사해서 .env.local로 쓰세요. .env.local은 커밋하지 않아요.
# 둘 다 서버(API 라우트)에서만 읽어요. NEXT_PUBLIC_ 붙이지 마세요.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 공공데이터포털 > 건강보험심사평가원_병원정보서비스 > 일반 인증키(Decoding)
HIRA_API_KEY=

# (선택) realtime 모델. 비우면 gpt-realtime-2.1-mini. 큰 모델: gpt-realtime-2.1 (약 3배 비쌈)
REALTIME_MODEL=
