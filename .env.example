# Supabase 프로젝트의 공개 설정. 비밀 키가 아니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI 비밀 키의 실제 값은 .env.local에만 보관한다.
RUNYOUR_API_KEY=
RUNYOUR_BASE_URL=https://api.runyour.ai/v1
CHAT_MODEL=openai/gpt-5.6-sol
OPENAI_API_KEY=
REALTIME_MODEL=

# Development-only memory pilot, disabled until DB migration and consent preview checks pass.
# Requires the here-dev Supabase URL. Production is blocked in code.
MEMORY_ENABLED=false
MEMORY_SUMMARY_MODEL=openai/gpt-5.6-luna
