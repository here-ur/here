# Supabase 프로젝트의 공개 설정. 비밀 키가 아니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI 비밀 키의 실제 값은 .env.local에만 보관한다.
# Text replies, memory summaries and embeddings share this Runyour credential.
RUNYOUR_API_KEY=
RUNYOUR_BASE_URL=https://api.runyour.ai/v1
CHAT_MODEL=openai/gpt-5.6-sol
# Voice only; memory embeddings no longer use the direct OpenAI platform.
OPENAI_API_KEY=
# Web voice: GPT-Live, Korean Noeul. Server-only; existing OpenAI key reused.
LIVE_MODEL=gpt-live-1
LIVE_VOICE=noeul
# Enable only after development migrations, worker dispatch and hosted verification.
VOICE_QUOTA_ENABLED=false
VOICE_WATCH_ENABLED=false
# Dedicated random 64-hex server capability; store only its SHA-256 in DB.
VOICE_CONTROL_SECRET=
# Legacy native client only. Web no longer reads REALTIME_MODEL.
REALTIME_MODEL=

# Development-only memory pilot, disabled until DB migration and consent preview checks pass.
# Requires the here-dev Supabase URL. Production is blocked in code.
MEMORY_ENABLED=false
MEMORY_SUMMARY_MODEL=openai/gpt-5.6-luna

# 구름 정원 3D 장면(Spline에서 내보낸 .splinecode 주소). 비워 두면 지금 2D 그림을 쓴다.
# 공개 주소라 NEXT_PUBLIC_로 둔다. 비밀 값이 아니다. 자세한 규칙은 docs/GARDEN_SPLINE.md.
NEXT_PUBLIC_GARDEN_SPLINE_URL=

# 제품 분석(PostHog). 프로젝트 키는 공개 값이라 NEXT_PUBLIC_로 둔다. 비워 두면 분석을 켜지 않는다.
# 로컬은 비워 둔다(분석을 손볼 때만 잠깐 넣는다). 보내는 이벤트와 기준은 docs/ANALYTICS.md.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
